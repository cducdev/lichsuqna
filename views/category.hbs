<link rel="stylesheet" href="/css/category.css" />
<style>
	.{{categoryTags}}
	{ border-bottom: 2px solid rgb(111, 111, 108); } .loader { border: 16px
	solid #f3f3f3; /* Light grey */ border-top: 16px solid #3498db; /* Blue */
	border-radius: 50%; width: 120px; height: 120px; animation: spin 2s linear
	infinite; margin:0 auto; } @keyframes spin { 0% { transform: rotate(0deg); }
	100% { transform: rotate(360deg); } }
</style>
<div class="category-path">
	<div class="category-container" style="margin: 110px auto">
		<div class="recom-text">
			<h1>Danh mục<br /> bài viết</h1>
			
		</div>
			<div class="category-tag">
				<ul class="category-tag-list">
					<li class="all">
						<a href="/blog/">Tất cả</a>
					</li>
					{{#if Auth}}
						<li class="Goi-y-cho-ban">
							<a href="/blog/Goi-y-cho-ban">Gợi ý cho bạn</a>
						</li>
					{{/if}}
					{{#each tagArr}}
						<li class="{{this.key}}">
							<a href="/blog/{{this.key}}/">{{this.value}}</a>
						</li>
					{{/each}}
				</ul>
			</div>
		<div class="search-bar">
			<label id="search"><i class="fa fa-search"></i></label>
			<input
				type="text"
				id="searchBar"
				placeholder="Tìm kiếm bài viết..."
			/>
		</div>
		<div class="post-recom">
			<div class="popular-post">
				{{#each blog}}
					<div class="blog-section">
						<div class="blog-card" data-id="{{this.id}}">
							<a href="/blog/{{this.categoryTag.[0]}}/{{this.id}}">
								<img
									src="{{this.bannerSrc}}"
									alt=""
									class="blog-img"
								/>
								<h2 style="margin-left:12px">{{this.title}}</h2>
								<div class="overview-content">
									{{this.overview}}
								</div>
							</a>
							<a
								href="/blog/{{this.categoryTag.[0]}}/{{this.id}}"
								class="btn grey"
							>Đọc bài</a>
						</div>
					</div>
				{{/each}}
			</div>
		</div>
	</div>
</div>
<script src="/js/category.js"></script>